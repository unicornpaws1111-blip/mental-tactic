# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_CLIENT_ID: Optional for Google One-Click Sign-In and Registration on the public website.
# Obtain from Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs (Web application).
# Authorized JavaScript Origins: https://<your-app-domain> (e.g. your APP_URL)
GOOGLE_CLIENT_ID=""
VITE_GOOGLE_CLIENT_ID=""

# ADMIN_EMAIL: Authorized administrator email for Mental Tactic.
# When authenticated, users with this email (or matching ADMIN_EMAILS allowlist) will see
# the Admin Dashboard access button and have full CMS management privileges.
ADMIN_EMAIL="admin@mentaltactic.com"
ADMIN_EMAILS="admin@mentaltactic.com"

# FIREBASE WEB CONFIGURATION (Client-side Google Sign-In)
# Obtain from Firebase Console > Project Settings > General > Your apps (Web app)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""

# FIREBASE ADMIN CONFIGURATION (Server-side Token Verification)
# In standard Firebase environments, FIREBASE_PROJECT_ID enables public cert verification.
# For elevated service account access, provide FIREBASE_CLIENT_EMAIL and FIREBASE_PRIVATE_KEY.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
