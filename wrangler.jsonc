{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mental-tactic",
  "main": "src/worker.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "FIREBASE_PROJECT_ID": "mental-tactic",
    "VITE_FIREBASE_PROJECT_ID": "mental-tactic",
    "ADMIN_EMAIL": "admin@mentaltactic.com",
    "ADMIN_EMAILS": "admin@mentaltactic.com"
  }
}
